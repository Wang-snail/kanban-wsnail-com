# Gemini（可选，AI 对话）
GEMINI_API_KEY=

# 管理接口鉴权：请求头 X-Admin-Token 必须等于此值
# 在 Cloudflare Pages → Settings → Environment variables 里配置为 Secret
# 切勿把真实 token 写进仓库
NODES_ADMIN_TOKEN=

# 健康检查：最低已发布节点数（默认 10）
NODES_MIN_PUBLISHED=10

# 健康检查自动恢复：published < min 时写入仓内 SEED
# 警告：仓内 SEED 是旧 N-001…，线上生产是 F02/Q06…，生产环境请保持关闭
# 取值：1 / true / yes / on
NODES_HEALTH_AUTORESTORE=
